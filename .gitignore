# Entornos virtuales
venv/
env/
ENV/
.venv/

# Variables de entorno y secretos
.env
.env.*
!.env.example

# Base de datos local y temporales
data/*.db
data/*.sqlite3
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/uploads/*
!data/uploads/.gitkeep
!data/.gitkeep

# Python / Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Streamlit (se sube solo config.toml; los secretos nunca)
.streamlit/*
!.streamlit/config.toml

# Sistema operativo
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
*.tmp
*.temp
